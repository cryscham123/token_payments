# Copy this file to .env for local development.
# Local dev only signing values below are committed only for localhost use.
# live/prod startup rejects these local dev values; replace them for non-local environments.
# Fill secrets only in your local .env file. Do not commit real private keys,
# API keys, seed phrases, or production credentials.

# DOCKER COMPOSE CONFIG VALIDATION
COMPOSE_PROFILES=runtime,smoke,api

# TEST NETWORK
TEST_NETWORK_PRIVATE_KEY=0xreplace_with_local_dev_only_private_key
TEST_NETWORK_ACCOUNT=0xreplace_with_local_dev_only_account
TEST_NETWORK_NETWORK_ID=1337
TEST_NETWORK_DB_PATH=/var/chainDB

# POSTGRES
POSTGRES_DB=token_payments
POSTGRES_USER=token_payments
POSTGRES_PASSWORD=replace_with_local_dev_only_password
TZ=Asia/Seoul

# DEFAULT DATABASE BOOTSTRAP
# Runs from postgres init on new volumes and from the postgres_seed one-shot service on compose up.
# Leave empty to use TEST_NETWORK_ACCOUNT as the local platform admin wallet.
BOOTSTRAP_ADMIN_WALLET_ADDRESS=

# API / WORKER RUNTIME
LOCAL_API_ORIGIN=https://localhost
API_PUBLIC_BASE_URL=https://localhost
RUNTIME_API_HOST=0.0.0.0
RUNTIME_API_PORT=8000
RUNTIME_ENVIRONMENT=local
RUNTIME_REQUEST_TIMEOUT_SECONDS=30
RUNTIME_WORKER_BATCH_SIZE=100
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=1
RUNTIME_RECEIPT_POLL_INTERVAL_SECONDS=5
REQUEST_BODY_MAX_BYTES=1048576

# BROWSER REQUEST GUARD
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CSRF_ACTIVE_KEY_ID=local-dev-csrf-2026
CSRF_SIGNING_KEY=local_dev_only_csrf_signing_key_32_bytes_for_localhost
CSRF_MAX_AGE_SECONDS=3600
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# SESSION COOKIE SIGNING
# Format: kid=secret,kid2=previous_secret. These committed local dev values are intentionally
# rejected by live/prod startup; replace them with uncommitted local-only material outside localhost.
SESSION_ACTIVE_KEY_ID=local-dev-2026
SESSION_SIGNING_KEYS=local-dev-2026=local_dev_only_session_signing_key_32_bytes_for_localhost
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000

# ADAPTER INFRASTRUCTURE
ADAPTER_POSTGRES_DSN=postgresql://token_payments:replace_with_local_dev_only_password@postgres:5432/token_payments
ADAPTER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ADAPTER_KAFKA_CLIENT_ID=token-payments-local
ADAPTER_OUTBOX_BATCH_SIZE=100
ADAPTER_OUTBOX_POLL_INTERVAL_SECONDS=1
ADAPTER_OUTBOX_RETRY_MAX_ATTEMPTS=5
ADAPTER_OUTBOX_RETRY_INITIAL_DELAY_SECONDS=0.5
ADAPTER_OUTBOX_RETRY_MAX_DELAY_SECONDS=30
ADAPTER_WALLET_SIGNATURE_DOMAIN=token-payments.local
# Auth smart-wallet signature verification uses the same local chain by default.
# Leave URL empty to reuse the composed blockchain RPC URL below.
# ADAPTER_AUTH_WALLET_SIGNATURE_TIMEOUT_SECONDS bounds ERC-1271 RPC calls.
# ADAPTER_AUTH_WALLET_SIGNATURE_CHAIN_ID mismatch rejects before signature recovery or contract lookup.
# walletSignature.rpcUrl is redacted in runtime/debug output; do not commit production RPC URLs.
ADAPTER_AUTH_WALLET_SIGNATURE_RPC_URL=
ADAPTER_AUTH_WALLET_SIGNATURE_CHAIN_ID=1337
ADAPTER_AUTH_WALLET_SIGNATURE_TIMEOUT_SECONDS=3
ADAPTER_BLOCKCHAIN_RPC_SCHEME=http
ADAPTER_BLOCKCHAIN_RPC_HOST=test_network
ADAPTER_BLOCKCHAIN_RPC_PORT=8545
ADAPTER_BLOCKCHAIN_RPC_PATH=
# Optional full URL override. Leave empty to compose it from SCHEME/HOST/PORT/PATH.
ADAPTER_BLOCKCHAIN_RPC_URL=
ADAPTER_BLOCKCHAIN_CHAIN_ID=1337
ADAPTER_BLOCKCHAIN_NATIVE_SYMBOL=ETH
ADAPTER_BLOCKCHAIN_NATIVE_DECIMALS=18
# Local test network writes deployed USDC/USDT contract addresses to this file.
# The postgres seed reads it and syncs payment_assets; do not configure a single token address.
ADAPTER_BLOCKCHAIN_DEPLOYED_CONTRACTS_PATH=/var/chainDB/deployed_contracts.json
# Local refund smoke tests can use the same local-only key as TEST_NETWORK_PRIVATE_KEY.
ADAPTER_BLOCKCHAIN_REFUND_PRIVATE_KEY=0xreplace_with_local_dev_only_private_key
ADAPTER_BLOCKCHAIN_REFUND_ACCOUNT=0xreplace_with_local_dev_only_account
ADAPTER_BLOCKCHAIN_GAS_BUFFER_RATE=0.10

# NGINX
HOST=localhost

# METAMASK EMBEDDED WALLET (WEB3.0 OAUTH)
# Obtain this from your MetaMask Developer Portal (developer.metamask.io) dashboard
NEXT_PUBLIC_METAMASK_CLIENT_ID=replace_with_your_metamask_dashboard_client_id
GOOGLE_CLIENT_ID=replace_with_your_google_cloud_oauth_client_id
