# Copy this file to .env for local development.
# copy this file to .env and replace session and CSRF signing placeholders
# Fill secrets only in your local .env file. Do not commit real private keys,
# API keys, seed phrases, or production credentials.

# DOCKER COMPOSE CONFIG VALIDATION
COMPOSE_PROFILES=runtime,smoke

# TEST NETWORK
TEST_NETWORK_PRIVATE_KEY=0xreplace_with_local_dev_only_private_key
TEST_NETWORK_ACCOUNT=0xreplace_with_local_dev_only_account
TEST_NETWORK_NETWORK_ID=1337
TEST_NETWORK_DB_PATH=/var/chainDB

# POSTGRES
POSTGRES_DB=token_payments
POSTGRES_USER=token_payments
POSTGRES_PASSWORD=replace_with_local_dev_only_password
TZ=Asia/Seoul

# API / WORKER RUNTIME
LOCAL_API_ORIGIN=http://localhost:8000
API_PUBLIC_BASE_URL=http://localhost:8000
RUNTIME_API_HOST=0.0.0.0
RUNTIME_API_PORT=8000
RUNTIME_ENVIRONMENT=local
RUNTIME_REQUEST_TIMEOUT_SECONDS=30
RUNTIME_WORKER_BATCH_SIZE=100
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=1
RUNTIME_RECEIPT_POLL_INTERVAL_SECONDS=5
REQUEST_BODY_MAX_BYTES=1048576

# BROWSER REQUEST GUARD
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8765
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
CSRF_ACTIVE_KEY_ID=local-dev-csrf
CSRF_SIGNING_KEY=replace_with_local_dev_only_csrf_signing_key
CSRF_MAX_AGE_SECONDS=3600
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# SESSION COOKIE SIGNING
# Format: kid=secret,kid2=previous_secret. This committed placeholder is intentionally rejected by
# live/prod startup; copy this file to .env and replace it with local-only secret material.
SESSION_ACTIVE_KEY_ID=local-dev-placeholder
SESSION_SIGNING_KEYS=local-dev-placeholder=replace_with_local_dev_only_session_signing_key
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000

# ADAPTER INFRASTRUCTURE
ADAPTER_POSTGRES_DSN=postgresql://token_payments:replace_with_local_dev_only_password@postgres:5432/token_payments
ADAPTER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ADAPTER_KAFKA_CLIENT_ID=token-payments-local
ADAPTER_OUTBOX_BATCH_SIZE=100
ADAPTER_OUTBOX_POLL_INTERVAL_SECONDS=1
ADAPTER_OUTBOX_RETRY_MAX_ATTEMPTS=5
ADAPTER_OUTBOX_RETRY_INITIAL_DELAY_SECONDS=0.5
ADAPTER_OUTBOX_RETRY_MAX_DELAY_SECONDS=30
ADAPTER_WALLET_SIGNATURE_DOMAIN=token-payments.local
ADAPTER_BLOCKCHAIN_RPC_URL=http://localhost:8545
ADAPTER_BLOCKCHAIN_CHAIN_ID=1337
ADAPTER_BLOCKCHAIN_NATIVE_SYMBOL=ETH
ADAPTER_BLOCKCHAIN_NATIVE_DECIMALS=18
ADAPTER_BLOCKCHAIN_TOKEN_ADDRESS=0xreplace_with_local_dev_only_token_address
ADAPTER_BLOCKCHAIN_GAS_BUFFER_RATE=0.10

# NGINX
HOST=
