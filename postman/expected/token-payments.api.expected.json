      "body": {
        "walletAddress": "0x1111111111111111111111111111111111111111",
        "domain": "token-payments.local",
        "address": "0x1111111111111111111111111111111111111111",
        "uri": "https://token-payments.local",
        "version": "1",
        "chainId": 1337,
        "nonce": "N0NCE001",
        "issuedAt": "2026-05-17T10:00:00+09:00",
